[Unit]
Description=Mu Agent SaaS API
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/mu-agent-saas
EnvironmentFile=/opt/mu-agent-saas/mu-agent-saas.env
ExecStart=/opt/mu-agent-saas/bin/mu-agent-server
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
