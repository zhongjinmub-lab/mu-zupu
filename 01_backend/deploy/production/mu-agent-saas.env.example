APP_ENV=production
HTTP_ADDR=127.0.0.1:18082
DATABASE_DSN=postgres://mu:REPLACE_POSTGRES_PASSWORD@127.0.0.1:15432/mu_agent_saas?sslmode=disable
REDIS_ADDR=127.0.0.1:16379
REDIS_PASS=
REDIS_DB=0
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_TENANT_PER_MINUTE=120
RATE_LIMIT_USER_PER_MINUTE=60
RATE_LIMIT_AUTH_IP_PER_MINUTE=20
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARS
JWT_ISSUER=mu-agent-saas
JWT_TTL_HOURS=24
MIGRATIONS_DIR=/opt/mu-agent-saas/migrations
STORAGE_ENDPOINT=127.0.0.1:19000
STORAGE_ACCESS_KEY=muadmin
STORAGE_SECRET_KEY=REPLACE_MINIO_PASSWORD
STORAGE_BUCKET=mu-agent-files
STORAGE_USE_SSL=false
STORAGE_PUBLIC_BASE=
UPLOAD_MAX_BYTES=52428800
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=local-hash-1536
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_SECONDS=30
GENERATION_PROVIDER=local
GENERATION_MODEL=local-rag
GENERATION_BASE_URL=
GENERATION_API_KEY=
GENERATION_TIMEOUT_SECONDS=60
DOCUMENT_WORKER_INTERVAL_SECONDS=10
DOCUMENT_WORKER_BATCH_SIZE=5
WEBHOOK_WORKER_INTERVAL_SECONDS=15
WEBHOOK_WORKER_BATCH_SIZE=20
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_BASE_SECONDS=60


# 支付渠道
# PAYMENT_CHANNELS 为逗号分隔的启用渠道,支持 mock、alipay、wechat
PAYMENT_CHANNELS=mock
# mock 渠道回调验签密钥(为空则保留开发体验,生产建议配置)
PAYMENT_CALLBACK_SECRET=
# 第三方异步通知回调的服务端基础地址(需公网可达),例如 https://api.example.com
PAYMENT_NOTIFY_BASE_URL=
# 支付完成后用户浏览器同步跳转地址
PAYMENT_RETURN_URL=
# 支付宝(启用 alipay 渠道时必填)
ALIPAY_APP_ID=
# 应用私钥:PKCS1/PKCS8 PEM 或裸 base64
ALIPAY_PRIVATE_KEY=
# 支付宝公钥:用于异步通知验签
ALIPAY_PUBLIC_KEY=
# 网关地址,留空使用正式环境 https://openapi.alipay.com/gateway.do
ALIPAY_GATEWAY=
ALIPAY_SIGN_TYPE=RSA2


# 微信支付 v3(启用 wechat 渠道时必填)
WECHAT_APP_ID=
WECHAT_MCH_ID=
# 商户 API 证书序列号
WECHAT_SERIAL_NO=
# APIv3 密钥(32 字节),用于回调资源体 AES-256-GCM 解密
WECHAT_API_V3_KEY=
# 商户 API 私钥:PKCS1/PKCS8 PEM 或裸 base64
WECHAT_PRIVATE_KEY=
# 微信支付平台证书公钥:用于回调验签
WECHAT_PLATFORM_PUBLIC_KEY=
# 网关地址,留空使用正式环境 https://api.mch.weixin.qq.com
WECHAT_GATEWAY=
