APP_ENV=production
HTTP_ADDR=127.0.0.1:18082
DATABASE_DSN=postgres://mu:REPLACE_POSTGRES_PASSWORD@127.0.0.1:15432/mu_agent_saas?sslmode=disable
REDIS_ADDR=127.0.0.1:16379
REDIS_PASS=
REDIS_DB=0
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARS
JWT_ISSUER=mu-agent-saas
JWT_TTL_HOURS=24
MIGRATIONS_DIR=/opt/mu-agent-saas/migrations
STORAGE_ENDPOINT=127.0.0.1:19000
STORAGE_ACCESS_KEY=muadmin
STORAGE_SECRET_KEY=REPLACE_MINIO_PASSWORD
STORAGE_BUCKET=mu-agent-files
STORAGE_USE_SSL=false
STORAGE_PUBLIC_BASE=
UPLOAD_MAX_BYTES=52428800
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=local-hash-1536
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_SECONDS=30
GENERATION_PROVIDER=local
GENERATION_MODEL=local-rag
GENERATION_BASE_URL=
GENERATION_API_KEY=
GENERATION_TIMEOUT_SECONDS=60
DOCUMENT_WORKER_INTERVAL_SECONDS=10
DOCUMENT_WORKER_BATCH_SIZE=5
WEBHOOK_WORKER_INTERVAL_SECONDS=15
WEBHOOK_WORKER_BATCH_SIZE=20
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_BASE_SECONDS=60
